{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "description": "Track the Playwright version installed by a RUN instruction, invisible to the dockerfile manager",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)images/node-ci-chromium/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\S+=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Keep the Chromium image aligned with the published Node CI base",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "ghcr.io/captive-studio/node-ci"
      ],
      "minimumReleaseAge": "1 day",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Keep the pinned Playwright in sync with the projects consuming the image",
      "matchDatasources": [
        "npm"
      ],
      "matchDepNames": [
        "playwright"
      ],
      "minimumReleaseAge": "1 day",
      "internalChecksFilter": "strict"
    }
  ]
}
