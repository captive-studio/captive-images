{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Keep the Chromium image aligned with the published Node CI base",
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "ghcr.io/captive-studio/node-ci"
      ],
      "minimumReleaseAge": "1 day",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Keep the pinned Playwright in sync with the projects consuming the image",
      "matchDatasources": [
        "npm"
      ],
      "matchDepNames": [
        "playwright"
      ],
      "minimumReleaseAge": "1 day",
      "internalChecksFilter": "strict"
    }
  ]
}
