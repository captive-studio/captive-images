{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "customManagers:dockerfileVersions"
  ],
  "packageRules": [
    {
      "description": "Le build du front de Send reste en Node 16 (webpack 4.38) : ne pas le monter de majeure",
      "matchFileNames": [
        "images/send/Dockerfile"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchDepNames": [
        "node"
      ],
      "matchCurrentVersion": "/^16\\./",
      "allowedVersions": "/^16\\./"
    }
  ]
}
