{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "description": "Track the Playwright version installed by a RUN instruction, invisible to the dockerfile manager",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)images/rails-ci/Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\S+=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Keep the pinned Playwright aligned with node-ci-chromium",
      "matchDatasources": [
        "npm"
      ],
      "matchDepNames": [
        "playwright"
      ],
      "minimumReleaseAge": "1 day",
      "internalChecksFilter": "strict"
    }
  ]
}
